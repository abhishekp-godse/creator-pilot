{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Localhost (Port 8080 - Auto Fallback)",
      "type": "shell",
      "command": ".\\START_LOCALHOST.bat",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "2. Run React Frontend (Port 5173)",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "3. Run FastAPI Backend (Port 8000)",
      "type": "shell",
      "command": "python -m venv venv; .\\venv\\Scripts\\activate; pip install -r requirements.txt; python -m uvicorn app.main:app --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    }
  ]
}
