# CreatorPilot Backend Configuration

# Set to True to use rich demo data when no API keys are available
USE_DEMO_DATA=True

# Optional: Official YouTube Data API v3 Key
# Get from Google Cloud Console: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Optional: LLM API Key for Conversational AI Coach
# (Supports Google Gemini or OpenAI. If left blank, intelligent built-in heuristic coach answers directly)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=True
